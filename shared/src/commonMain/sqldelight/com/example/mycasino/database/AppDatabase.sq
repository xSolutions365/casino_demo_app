CREATE TABLE UserEntity (
    id INTEGER NOT NULL PRIMARY KEY,
    username TEXT NOT NULL,
    email TEXT NOT NULL
);

-- Note: The line below defines a function named selectAllUsers() in Kotlin
selectAllUsers:
SELECT * FROM UserEntity;

insertUser:
INSERT OR REPLACE INTO UserEntity(id, username, email)
VALUES (?, ?, ?);

deleteUser:
DELETE FROM UserEntity WHERE id = ?;